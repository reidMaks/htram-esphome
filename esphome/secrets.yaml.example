# Скопіюй у esphome/secrets.yaml і заповни. secrets.yaml НЕ комітити.
wifi_ssid: "YourWiFi"
wifi_password: "YourWiFiPassword"

# Ключ шифрування API (32 байти base64). Згенерувати:
#   openssl rand -base64 32
api_key: "REPLACE_WITH_BASE64_KEY"

# Пароль OTA (будь-який рядок).
ota_password: "REPLACE_WITH_OTA_PASSWORD"

# Пароль резервної точки доступу "HTRAM Setup" (WPA2, мінімум 8 символів).
# Пристрій піднімає її, коли не бачить домашньої мережі.
ap_password: "REPLACE_WITH_AP_PASSWORD"

# Доступ до веб-інтерфейсу пристрою (порт 80, digest-автентифікація).
web_username: "admin"
web_password: "REPLACE_WITH_WEB_PASSWORD"
