#!/usr/bin/env bash
set -e

echo "========================================================"
echo "  Running pre-commit quality gates..."
echo "========================================================"

echo "==> 1/3: Checking code formatting (ruff & clang-format)..."
make format-check

echo "==> 2/3: Running static analysis & linters (fanalyzer, yamllint, ruff, mypy)..."
make lint

echo "==> 3/3: Running unit tests and config validations..."
make test

echo "========================================================"
echo "  All pre-commit checks passed! Committing changes..."
echo "========================================================"
