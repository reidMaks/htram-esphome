# Hardware session artifacts. Never commit these:
# a 4 MB flash image, the broker's self-signed cert and its PRIVATE KEY,
# raw UART/MQTT capture logs, and the downlink publish queue.
esp32-dump.bin
gd32_flash.bin
tools/swd/*.bin
tools/swd/*.elf
*.pdf
*.pem
*.log
outbox.txt

# Референсне фото заводського екрана для пісочниці дизайну. Продуктове
# зображення виробника не наше, тож кожен кладе сюди власне фото.
tools/uidesign/reference.webp

